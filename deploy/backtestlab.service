# systemd unit for the API server.
#   sudo cp backtestlab.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now backtestlab
# Logs: sudo journalctl -u backtestlab -f

[Unit]
Description=BacktestLab API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backtestlab
Group=backtestlab
# server.mjs and .env live here
WorkingDirectory=/opt/backtestlab/server
# check the path with: which node
ExecStart=/usr/bin/node /opt/backtestlab/server/server.mjs
Environment=NODE_ENV=production
Restart=always
RestartSec=3
# creates /var/lib/backtestlab owned by the service user (set DATA_DIR=/var/lib/backtestlab in .env)
StateDirectory=backtestlab
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/backtestlab

[Install]
WantedBy=multi-user.target
