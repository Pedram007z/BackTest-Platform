# Copy to server/.env and fill in. Everything else (SMS keys, gateway merchant ids, plans, prices,
# discount codes, market data sources) is set in the admin panel at /#/admin.

# Production settings; DEPLOY.md walks through them. For local development you only need ADMIN_PHONES.
NODE_ENV=production
PORT=8787
# 127.0.0.1 behind nginx (the API is then reachable only through it)
HOST=127.0.0.1

# Where the web app is served, and the public address of this API.
# Payment gateways call back to ${PUBLIC_URL}/api/payments/callback/<gateway>,
# which then sends the browser to ${APP_URL}/#/billing.
APP_URL=https://backtestlab.ir
PUBLIC_URL=https://backtestlab.ir
# Addresses the site is opened at, comma separated (defaults to APP_URL)
CORS_ORIGINS=https://backtestlab.ir,https://www.backtestlab.ir

# Phones that become admins when they sign in (comma separated).
ADMIN_PHONES=09120000000

# Database, calendar and market-data cache.
DATA_DIR=/var/lib/backtestlab

# Behind nginx: read the visitor's address from X-Real-IP (see deploy/nginx-site.conf).
TRUST_PROXY=true

# Development helpers. Both default to on when NODE_ENV is not "production"; keep them off on a real server.
# OTP_DEV_ECHO=false       # return the sign-in code to the browser while SMS sending is off
# PAYMENT_SIMULATOR=false  # complete payments on a local test page instead of the bank

SESSION_DAYS=30
NEWS_SYNC_MINUTES=60
UPSTREAM_TIMEOUT_MS=15000

# Upstream data sources. Servers inside Iran usually cannot reach these directly; point them at a
# relay or reverse proxy abroad that forwards to the same paths.
# FF_BASE_URL=https://www.forexfactory.com
# FF_FEED_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
# DUKASCOPY_API_URL=https://jetta.dukascopy.com/v1        (Dukascopy's data API, tried first; off = datafeed only)
# DUKASCOPY_URL=https://datafeed.dukascopy.com/datafeed
# BINANCE_URL=https://data-api.binance.vision
